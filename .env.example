# Copy to .env and fill in your 5paisa API keys from https://xstream.5paisa.com

APP_NAME=YOUR_APP_NAME
APP_SOURCE=YOUR_APP_SOURCE
USER_ID=YOUR_USER_ID
PASSWORD=YOUR_PASSWORD
USER_KEY=YOUR_USER_KEY
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY

# OAuth redirect URL (register at 5paisa developer portal)
RESPONSE_URL=https://www.5paisa.com/technology/developer-apis

# TOTP login (optional — enable TOTP in 5paisa trade station first)
CLIENT_ID=your_client_code
PIN=your_pin
TOTP_SECRET=your_totp_secret
